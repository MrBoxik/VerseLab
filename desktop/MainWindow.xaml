<Window x:Class="VerseLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verse Lab" Width="1240" Height="800" MinWidth="860" MinHeight="620"
        Background="#15121B" Foreground="#F2EAFB" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing"
        PreviewKeyDown="KeyboardShortcut">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Open audio…" Click="OpenFile"/>
        <Button Content="Music folder…" Click="ChooseFolder"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Verse Lab" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock x:Name="LibraryStatus" Foreground="{StaticResource Muted}" Text="Loading music library…"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="Rescan" Click="Rescan"/>
              <TextBlock Text="Library" FontSize="19" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="Search music"
                     ToolTip="Search by song name" TextChanged="FilterLibrary"/>
            <TextBlock x:Name="LibraryCount" Margin="0,7" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <ListBox x:Name="Library" DisplayMemberPath="Name" MouseDoubleClick="OpenSelected"
                   KeyDown="OpenSelectedKey" AutomationProperties.Name="Music library"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="10" Padding="16" Margin="12,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TrackTitle" Text="Choose a song" FontSize="26" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <TextBlock x:Name="TrackArtist" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="SourceLabel" Margin="0,8,0,6" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Content="Prepare lyrics" Click="PrepareLyrics"/>
              <Button Content="Find lyrics…" Click="FindLyrics"/>
              <Button Content="Import…" Click="ImportLyrics"/>
              <Button Content="Export…" Click="ExportLyrics"/>
            </WrapPanel>
            <TextBlock x:Name="ActiveWords" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"
                       Margin="0,8,0,8" Foreground="{StaticResource Accent}"/>
          </StackPanel>
          <ListBox x:Name="LyricsList" MouseDoubleClick="JumpToLine"
                   AutomationProperties.Name="Song lyrics">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#3D3052"/>
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel ToolTip="{Binding Review}">
                  <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource Muted}"/>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="18"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="10" Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Library preparation" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox x:Name="BatchScope" SelectedIndex="0" Margin="0,0,0,7" AutomationProperties.Name="Batch scope">
              <ComboBoxItem Content="First 10 search results"/>
              <ComboBoxItem Content="Entire library"/>
            </ComboBox>
            <WrapPanel>
              <Button x:Name="StartBatchButton" Content="Start batch" Click="StartBatch"/>
              <Button x:Name="PauseBatchButton" Content="Pause" Click="PauseBatch" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock x:Name="BatchStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="PositionLabel" Text="0:00" VerticalAlignment="Center" Width="46"/>
        <Slider x:Name="Position" Grid.Column="1" Maximum="1" VerticalAlignment="Center"
                IsMoveToPointEnabled="True" ValueChanged="SeekChanged" AutomationProperties.Name="Playback position"/>
        <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="0:00" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <DockPanel Margin="0,6,0,0">
        <WrapPanel DockPanel.Dock="Left">
          <Button Content="Previous" Click="Previous"/>
          <Button x:Name="PlayButton" Content="Play" Click="PlayPause" MinWidth="70"/>
          <Button Content="Next" Click="Next"/>
        </WrapPanel>
        <Button x:Name="CancelPreparation" DockPanel.Dock="Right" Content="Cancel preparation"
                Click="CancelLyrics" Visibility="Collapsed"/>
        <Slider x:Name="Volume" DockPanel.Dock="Right" Width="85" Maximum="1" Value=".7"
                VerticalAlignment="Center" ToolTip="Volume" AutomationProperties.Name="Volume"
                ValueChanged="VolumeChanged"/>
        <TextBlock x:Name="Activity" Text="Double-click a track to play" Margin="8,5,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
