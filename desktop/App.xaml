<Application x:Class="VerseLab.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#201B2A"/>
    <SolidColorBrush x:Key="Border" Color="#393145"/>
    <SolidColorBrush x:Key="Muted" Color="#B0A1BE"/>
    <SolidColorBrush x:Key="Accent" Color="#DAC0FF"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F2EAFB"/>
      <Setter Property="Background" Value="#30263D"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,6,5"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2EAFB"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Background" Value="#191520"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Padding" Value="7"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Foreground" Value="#F2EAFB"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F2EAFB"/>
      <Setter Property="Margin" Value="0,4,10,4"/>
    </Style>
  </Application.Resources>
</Application>
